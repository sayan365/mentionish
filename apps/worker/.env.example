REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379
DISCOVERY_PROCESSING_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never expose this as NEXT_PUBLIC_* or copy it into the dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DISCOVERY_WORKER_ID=worker-local
REDDIT_DISCOVERY_ENABLED=false
REDDIT_POLICY_RISK_ACCEPTED=false
REDDIT_KILL_SWITCH=false
# oauth remains preferred; opencli is the verified desktop fallback; rdt_cli is legacy.
REDDIT_DATA_BACKEND=oauth
REDDIT_COOKIE_BACKEND_RISK_ACCEPTED=false
REDDIT_BROWSER_BACKEND_RISK_ACCEPTED=false
REDDIT_MAX_QUERIES_PER_SCAN=5
REDDIT_MAX_RESULTS_PER_QUERY=25
REDDIT_REVALIDATION_BATCH_SIZE=10
REDDIT_CLEAR_AUTH_HALT=false
REDDIT_CLEAR_RATE_LIMIT_COOLDOWN=false
# OAuth backend only
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:mentionish:0.1 (by /u/your-reddit-account)
# Shared fallback identity
REDDIT_ACCOUNT_USERNAME=
# rdt_cli backend only. Keep the cookie under the isolated REDDIT_RDT_HOME.
REDDIT_RDT_EXECUTABLE=rdt
# Absolute isolated home; credential goes under .config/rdt-cli/credential.json.
REDDIT_RDT_HOME=
REDDIT_RDT_TIMEOUT_SECONDS=45
# opencli backend only; install the package and use its absolute JS entrypoint.
REDDIT_OPENCLI_SCRIPT=
REDDIT_OPENCLI_TIMEOUT_SECONDS=60
# AI classification stays off until the migration and server-only API key are ready.
AI_CLASSIFICATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_CLASSIFIER_PROMPT_VERSION=intent-v1
OPENAI_CLASSIFIER_MAX_OUTPUT_TOKENS=250
AI_CLASSIFICATION_CONCURRENCY=2
# Drafting runs only after an explicit authenticated user request.
AI_DRAFTING_ENABLED=false
OPENAI_DRAFT_MODEL=gpt-5.6-terra
OPENAI_DRAFT_PROMPT_VERSION=draft-v1
OPENAI_DRAFT_MAX_OUTPUT_TOKENS=800
AI_DRAFTING_CONCURRENCY=1
