{
  "manifest_version": 3,
  "name": "Mentionish",
  "version": "0.0.1",
  "description": "Insert a user-reviewed Mentionish draft into Reddit's native editor. Submission always remains manual.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/r/*/comments/*",
        "https://old.reddit.com/r/*/comments/*",
        "https://new.reddit.com/r/*/comments/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
