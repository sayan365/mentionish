# Local mode is the default and requires no hosted credentials.
MENTIONISH_RUNTIME_MODE=local
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000
# MENTIONISH_DATA_DIR=C:\path\to\portable\mentionish-data

# Hosted compatibility only; ignored in local mode.
# MENTIONISH_RUNTIME_MODE=hosted
# REDIS_URL=redis://localhost:6379
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# Experimental local Reddit requires both flags plus a verified OpenCLI profile.
REDDIT_DISCOVERY_ENABLED=false
REDDIT_POLICY_RISK_ACCEPTED=false
