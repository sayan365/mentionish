# Mentionish requires no hosted credentials.
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000
# MENTIONISH_DATA_DIR=C:\path\to\portable\mentionish-data

# Experimental local Reddit requires both flags plus a verified OpenCLI profile.
REDDIT_DISCOVERY_ENABLED=false
REDDIT_POLICY_RISK_ACCEPTED=false
