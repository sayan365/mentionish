{
  "name": "mentionish",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "start": "node scripts/start-local.mjs",
    "start:local:no-open": "node scripts/start-local.mjs --no-open",
    "smoke:clean-install": "node scripts/start-local.mjs --smoke",
    "dev": "turbo dev",
    "lint": "eslint scripts && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "quality:benchmark": "tsx apps/api/src/scans/run-quality-benchmark.ts",
    "local:doctor": "tsx apps/api/src/local/doctor.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
